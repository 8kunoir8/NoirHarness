{
  "name": "@noir/desktop",
  "productName": "NoirHarness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "pnpm --filter @noir/app-kernel build && pnpm build:electron && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "pnpm --filter @noir/app-kernel build && vite build && pnpm build:electron",
    "build:electron": "esbuild src/main.ts src/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist --out-extension:.js=.cjs",
    "package": "pnpm build && node scripts/stage-package.mjs && electron-builder --win nsis",
    "package:dir": "pnpm build && node scripts/stage-package.mjs && electron-builder --win --dir",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "pnpm build && playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@noir/protocol": "workspace:*",
    "@playwright/test": "^1.50.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^38.0.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.0",
    "monaco-editor": "^0.52.2",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.0"
  }
}
